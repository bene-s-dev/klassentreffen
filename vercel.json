{
  "headers": [
    {
      "source": "/klassentreffen.ics",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/calendar; charset=utf-8"
        },
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"klassentreffen.ics\""
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/"
    }
  ]
}
